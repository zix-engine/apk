# Salin ke .env lalu isi. JANGAN commit .env. Contoh nilai di bawah BUKAN rahasia sungguhan.
PORT=3000
# Dengarkan hanya lokal; nginx yang membuka ke internet.
HOST=127.0.0.1
# 1 bila di belakang nginx/reverse proxy (percaya header X-Forwarded-For dari proxy lokal)
TRUST_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zixfunction
DB_USER=zixapi
DB_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK

# Opsional
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
SCRYPT_N=32768
